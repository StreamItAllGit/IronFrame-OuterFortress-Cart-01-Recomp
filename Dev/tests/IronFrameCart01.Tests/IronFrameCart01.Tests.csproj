<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(IronFrameTestAutomation)' == 'true'">
    <DefineConstants>$(DefineConstants);IRONFRAME_TEST_AUTOMATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IronFrameCart01.RecipeGen\IronFrameCart01.RecipeGen.csproj" />
    <ProjectReference Include="..\..\src\IronFrameCart01.Module\IronFrameCart01.Module.csproj" />
    <ProjectReference Include="..\..\src\IronFrameCart01.Launcher\IronFrameCart01.Launcher.csproj" />
    <ProjectReference Include="..\..\src\IronFrameCart01.Installer\IronFrameCart01.Installer.csproj" />
    <Reference Include="Foundation.Core">
      <HintPath>..\..\lib\Foundation.Core.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Installer">
      <HintPath>..\..\lib\Foundation.Installer.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Launcher">
      <HintPath>..\..\lib\Foundation.Launcher.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Retro">
      <HintPath>..\..\lib\Foundation.Retro.dll</HintPath>
    </Reference>
    <Reference Include="reEngine.Core">
      <HintPath>..\..\lib\reEngine.Core.dll</HintPath>
    </Reference>
    <Reference Include="reCart.Contracts">
      <HintPath>..\..\lib\reCart.Contracts.dll</HintPath>
    </Reference>
    <Reference Include="reCart.Core">
      <HintPath>..\..\lib\reCart.Core.dll</HintPath>
    </Reference>
    <Reference Include="reCart.Compiler">
      <HintPath>..\..\lib\reCart.Compiler.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' Or '$(IronFrameTestAutomation)' == 'true'">
    <Reference Include="Foundation.Automation">
      <HintPath>..\..\lib\Foundation.Automation.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.UI">
      <HintPath>..\..\lib\Foundation.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
